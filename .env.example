# TRACE-X Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="TRACE-X"
VERSION="1.0.0"

# Relational Database URL (SQLite default for zero-config local run; or PostgreSQL)
# Local SQLite: sqlite:///./trace_x.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/trace_x
DATABASE_URL=sqlite:///./trace_x.db

# Storage
STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_BYTES=52428800

# AI Provider Settings (Deterministic by default - no external key needed)
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434
